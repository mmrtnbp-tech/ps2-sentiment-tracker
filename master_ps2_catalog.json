import requests
import json

# Fetch complete PS2 game database mapping from open GitHub repo
url = "https://raw.githubusercontent.com/niemasd/GameDB-PS2/master/PS2.titles.json"
response = requests.get(url)

if response.status_code == 200:
    raw_titles = response.json()
    
    # Deduplicate disc IDs into unique game titles
    unique_titles = sorted(list(set(raw_titles.values())))
    
    catalog = []
    for idx, title in enumerate(unique_titles, 1):
        catalog.append({
            "id": f"PS2-{idx:04d}",
            "title": title,
            "track_top_50": False  # Toggle true for target games
        })

    with open("master_ps2_catalog.json", "w", encoding="utf-8") as f:
        json.dump(catalog, f, indent=2)

    print(f"✅ Generated master_ps2_catalog.json with {len(catalog)} games!")
